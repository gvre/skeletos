{
  "name": "skeletos",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.14.0",
  "version": "APP_VERSION",
  "commit": "GIT_COMMIT",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "lint:all": "pnpm run lint && pnpm run lint:circular",
    "lint": "pnpm run lint:base src",
    "lint:fix": "pnpm run lint:base src -- --fix",
    "lint:base": "eslint -c eslint.config.js --max-warnings 0",
    "lint:circular": "madge --circular --extensions ts src",
    "prettier:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/cors": "^2.8.19",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.17.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "supertest": "^7.1.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "tsx": "^4.20.4",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "module": "src/index.ts",
  "lint-staged": {
    "*.{ts,js,md,yaml,yml}": "prettier --write"
  }
}
